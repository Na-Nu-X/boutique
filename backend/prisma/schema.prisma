// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BoutiqueConfig {
  id              Int      @id @default(autoincrement())
  is_force_closed Boolean  @default(false)
  closure_reason  String?  @db.VarChar(250) 

  @@map("boutique_config")
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model OpeningHour {
  id                Int       @id @default(autoincrement())
  day_of_week       Int       @unique @default(1)
  open_time         String   @db.VarChar(5) // Uloží napr. "08:00"
  close_time        String   @db.VarChar(5) // Uloží napr. "20:00"
  is_closed_all_day Boolean   @default(false)

  @@map("opening_hour")
}

model Clothing {
  id              Int       @id @default(autoincrement())
  title           String    @db.VarChar(20)
  description     String    @db.VarChar(200)
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId      Int?      @map("category_id")
  price           Int       @default(0)
  images          Image[]
  modifier_groups ClothingModifierGroup[]
  order_items     OrderItem[]
  ratings         Rating[]

  @@map("clothing")
}

model Image {
  id          Int       @id @default(autoincrement())
  clothing_id Int
  clothing    Clothing  @relation(fields: [clothing_id], references: [id], onDelete: Cascade)
  url         String
  alt_text    String?
  sort_order  Int       @default(0)

  @@map("image")
}

model FilterGroup {
  id         Int        @id @default(autoincrement())
  name       String     @unique @db.VarChar(50)
  categories Category[]

  @@map("filter_group")
}

model Category {
  id       Int          @id @default(autoincrement())
  group    FilterGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId  Int?         @map("group_id")
  name     String       @unique @db.VarChar(50)
  icon     String       @default("fa-solid fa-list") @db.VarChar(100)
  clothing Clothing[]

  @@map("category")
}

model ClothingModifierGroup {
  id                 Int                    @id @default(autoincrement())
  clothing_id        Int
  clothing           Clothing               @relation(fields: [clothing_id], references: [id], onDelete: Cascade)
  title              String                 @db.VarChar(100)
  is_multiple_choice Boolean                @default(false)
  is_required        Boolean                @default(true)
  items              ClothingModifierItem[]

  @@map("clothing_modifier_group")
}

model ClothingModifierItem {
  id          Int                   @id @default(autoincrement())
  group_id    Int
  group       ClothingModifierGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  title       String                @db.VarChar(100)
  extra_price Int                   @default(0)

  @@map("clothing_modifier_item")
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  DELIVERING
  COMPLETED
  CANCELLED
}

model Order {
  id               Int         @id @default(autoincrement())
  tracking_code    String      @unique @db.VarChar(6)
  first_name       String      @db.VarChar(20)
  last_name        String      @db.VarChar(50)
  address          String      @db.VarChar(100)
  city             String      @db.VarChar(50)
  phone_number     String      @db.VarChar(50)
  message          String?     @db.VarChar(250)
  price            Int         @default(0)
  total_price      Int         @default(0)
  status           OrderStatus @default(PENDING)
  stripe_intent_id String?     @unique @db.VarChar(255)
  cash_on_delivery Boolean     @default(false)
  creation_time    DateTime    @default(now())
  items            OrderItem[]
  ratings          Rating[]

  @@map("order")
}

model OrderItem {
  id                Int       @id @default(autoincrement())
  order_id          Int
  order             Order     @relation(fields: [order_id], references: [id], onDelete: Cascade)
  clothing_id       Int?
  clothing          Clothing? @relation(fields: [clothing_id], references: [id], onDelete: SetNull)
  quantity          Int       @default(1)
  price_at_purchase Int       @default(0)
  is_tip            Boolean   @default(false)

  @@map("order_item")
}

model Rating {
  id            Int      @id @default(autoincrement())
  order_id      Int
  order         Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  clothing_id   Int
  clothing      Clothing @relation(fields: [clothing_id], references: [id], onDelete: Cascade)
  rating        Int      @default(1)
  creation_time DateTime @default(now())

  @@map("rating")
}

model ContactMessage {
  id            Int      @id @default(autoincrement())
  first_name    String   @db.VarChar(20)
  last_name     String   @db.VarChar(50)
  email_address String   @db.VarChar(50)
  message       String   @db.VarChar(250)
  creation_time DateTime @default(now())

  @@map("contact_message")
}

model Coupon {
  id               Int      @id @default(autoincrement())
  code             String   @unique @db.VarChar(50)
  discount_percent Int      @default(5)
  is_active        Boolean  @default(true)
  valid_until      DateTime
  creation_time    DateTime @default(now())

  @@map("coupon")
}